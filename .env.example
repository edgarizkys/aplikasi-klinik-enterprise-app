PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_something_secure_and_long

# Turso SQLite Configuration
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# BPJS Integration
BPJS_CLIENT_ID=your_bpjs_client_id
BPJS_CLIENT_SECRET=your_bpjs_client_secret
BPJS_API_URL=https://api.bpjs-kesehatan.go.id/sigap

# Payment Gateway (Midtrans/Xendit)
PAYMENT_GATEWAY_API_KEY=your_payment_api_key
PAYMENT_GATEWAY_SERVER_KEY=your_payment_server_key
PAYMENT_GATEWAY_IS_SANDBOX=true

# App Settings
APP_NAME="Aplikasi Klinik Enterprise"
APP_URL=http://localhost:3000
CURRENCY=IDR