PORT=3000
NODE_ENV=development

# Turso SQLite Configuration
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Authentication
JWT_SECRET=your-strong-random-secret-key-here
JWT_EXPIRES_IN=24h

# BPJS Integration
BPJS_CLIENT_ID=your-bpjs-client-id
BPJS_CLIENT_SECRET=your-bpjs-client-secret
BPJS_API_URL=https://api.bpjs-kesehatan.go.id/sigap

# Notification Service (WhatsApp/Email)
WA_API_KEY=your-whatsapp-api-key
WA_SENDER_NUMBER=628123456789
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-email-user
EMAIL_PASS=your-email-pass

# App Settings
APP_NAME="Aplikasi Klinik Enterprise"
APP_URL=http://localhost:3000
CURRENCY=IDR